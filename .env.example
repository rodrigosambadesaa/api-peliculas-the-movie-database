# Copia este archivo como .env.

# Seguridad: obligatorio al ejecutar Docker/producción.
# Genera un valor aleatorio de 32 caracteres como mínimo (por ejemplo: openssl rand -hex 32).
JWT_SECRET=
# Actívalo únicamente cuando la web se sirva mediante HTTPS.
COOKIE_SECURE=false

# Catálogo TMDB. Recomendado: API Read Access Token (Bearer).
TMDB_READ_TOKEN=
# Alternativa compatible con la API v3:
TMDB_API_KEY=
TMDB_LANGUAGE=es-ES
TMDB_REGION=ES

# Opcional para desarrollo sin Docker:
PORT=3000
DATABASE_PATH=./data/cinewave.db
WEB_ORIGIN=http://localhost:5173
# false al acceder directamente a Node. Usa un número de saltos solo detrás de un proxy de confianza.
TRUST_PROXY=false
