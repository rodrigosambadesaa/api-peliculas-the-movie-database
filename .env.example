# Copia este archivo como .env para conectar el catálogo completo.
# Recomendado: usa el API Read Access Token de TMDB (Bearer).
TMDB_READ_TOKEN=
# Alternativa compatible con la API v3:
TMDB_API_KEY=
TMDB_LANGUAGE=es-ES
TMDB_REGION=ES

# Cambia este valor en cualquier entorno compartido o público.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
# Actívalo únicamente cuando la web se sirva mediante HTTPS.
COOKIE_SECURE=false

# Opcional para desarrollo sin Docker:
PORT=3000
DATABASE_PATH=./data/cinewave.db
WEB_ORIGIN=http://localhost:5173
